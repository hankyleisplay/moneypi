{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoneyPi",
  "version": "0.2.0",
  "identifier": "com.moneypi.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "MoneyPi 資產追蹤", "width": 1000, "height": 720, "minWidth": 760, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
